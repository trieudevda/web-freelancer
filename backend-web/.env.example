NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000
LOG_DIRECTORY=logs

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=replace_with_your_database_password
DB_DATABASE=web_freelancer
DB_SYNCHRONIZE=false
DB_POOL_CONNECTION_LIMIT=20
DB_POOL_QUEUE_LIMIT=100
DB_SLOW_QUERY_THRESHOLD_MS=1000

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000

REQUEST_TIMEOUT_MS=30000
SLOW_REQUEST_THRESHOLD_MS=2000
MAX_CONCURRENT_REQUESTS=200
SHUTDOWN_GRACE_MS=15000
EVENT_LOOP_LAG_THRESHOLD_MS=200
SERVER_HEADERS_TIMEOUT_MS=35000
SERVER_KEEP_ALIVE_TIMEOUT_MS=5000

COOKIE_SECRET=replace_with_a_random_secret_of_at_least_64_characters
COOKIE_DOMAIN=
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_SESSION_RETENTION_DAYS=30

# Chỉ dùng để tạo tài khoản superadmin đầu tiên. Cung cấp cả hai biến,
# khởi động ứng dụng một lần, sau đó có thể xóa cả hai dòng này.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

MEDIA_ROOT=storage/media
MEDIA_TIMEZONE=Asia/Ho_Chi_Minh
MEDIA_MAX_IMAGE_SIZE=10485760
MEDIA_MAX_VIDEO_SIZE=1073741824

SWAGGER_ENABLED=true
TRUSTED_PROXY_CIDRS=
